# Public site URL (share image, sitemap)
VITE_SITE_URL=https://your-domain.com
# AniList app client ID (anilist.co/settings/developer), redirect URL: https://your-domain.com/auth/anilist
VITE_ANILIST_CLIENT_ID=53784

# Zenkai Shield (server). Leave unset to turn the shield off. On Cloudflare: npx wrangler pages secret put SHIELD_SECRET
# SHIELD_SECRET=long-random-string

# Optional external streaming proxy URL (e.g. deployed on Lovable or Cloudflare Workers).
# When unset or in local dev server, Zenkai automatically uses local /proxy.
# STREAM_PROXY_URL=https://proxy-publish-pilot.lovable.app/api/public/proxy

# Supabase (build-time; set in Cloudflare Pages > Settings > Variables and Secrets, then redeploy)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TMDB Server-Side Credentials (Cloudflare Pages > Settings > Variables and Secrets)
TMDB_API_KEY=c7db6169bfdd3fc9f7dd6c44ea8ad100
